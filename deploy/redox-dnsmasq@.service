[Unit]
Description=RedoX VE konuk ağı DHCP ve DNS (%i)
After=redox-hostnet.service
ConditionPathExists=/var/lib/redox-dnsmasq/%i.conf

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/lib/redox-dnsmasq/%i.conf --pid-file=
Restart=on-failure
RestartSec=5
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/redox-dnsmasq
